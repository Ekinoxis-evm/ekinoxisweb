{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx tsc:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(node design/detect-gate.mjs:*)",
      "Bash(npx impeccable:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(rm -rf .next:*)",
      "Bash(./.claude/hooks/*)",
      "Bash(vercel ls:*)",
      "Bash(vercel env ls:*)",
      "Bash(vercel whoami)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_migrations",
      "mcp__supabase__get_advisors",
      "mcp__supabase__query_logs",
      "mcp__supabase__search_docs",
      "mcp__plugin_supabase_supabase__list_tables",
      "mcp__plugin_supabase_supabase__get_advisors",
      "mcp__plugin_supabase_supabase__get_project_url",
      "mcp__plugin_vercel_vercel__list_deployments",
      "mcp__plugin_vercel_vercel__get_runtime_logs",
      "mcp__plugin_vercel_vercel__list_projects",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_resize",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__plugin_playwright_playwright__browser_console_messages"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(vercel --prod:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset:*)",
      "mcp__supabase__apply_migration",
      "mcp__supabase__execute_sql",
      "mcp__supabase__deploy_edge_function",
      "mcp__plugin_supabase_supabase__apply_migration",
      "mcp__plugin_supabase_supabase__execute_sql"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Bash(cat *.env)",
      "Bash(cat *.env.local)",
      "Bash(cat *.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/guard-env.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/secret-scan.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/post-edit-typecheck.sh",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/on-stop-summary.sh"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "supabase",
    "context7",
    "vercel",
    "figma"
  ]
}
